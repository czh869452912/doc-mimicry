# .env.example — copy to .env.local for local overrides, or .env for shared dev defaults
DATABASE_URL=postgresql+psycopg2://docagent:docagent@localhost:5432/docagent
REDIS_URL=redis://localhost:6379/0
DOCAGENT_QUEUE=celery
DOCAGENT_STATE_ROOT=/workspace/state
DOCAGENT_RUNTIME=mock-acp
VITE_API_BASE=http://localhost:8000

# Host-side ACP runtime URL, used by smoke tests and browser checks on the host.
DOCAGENT_ACP_RUNTIME_URL=http://127.0.0.1:8001

# Container-side URL for Docker Compose services to reach the ACP runtime service.
# start-dev.cmd sets http://openhands:8001 automatically for -Runtime openhands-acp.
DOCAGENT_ACP_CONTAINER_RUNTIME_URL=http://openhands:8001

# Required only when DOCAGENT_RUNTIME=openhands-acp.
LLM_API_KEY=sk-docagent-local
LLM_MODEL=docagent/default
LLM_BASE_URL=http://litellm:4000

# LiteLLM gateway. Provider keys are only required for live OpenHands runs.
LITELLM_MASTER_KEY=sk-docagent-local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DOCAGENT_LITELLM_DEFAULT_MODEL=openai/gpt-4o-mini
DOCAGENT_LITELLM_FAST_MODEL=openai/gpt-4o-mini
DOCAGENT_LITELLM_REASONING_MODEL=openai/gpt-4o
DOCAGENT_LITELLM_REASONING_API_KEY=${OPENAI_API_KEY}
